{
  "name": "wingman-vscode",
  "publisher": "adrianliechti",
  "displayName": "Wingman AI",
  "description": "Wingman AI",
  "version": "0.5.2",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianliechti/wingman-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "agentsWindow": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Wingman",
      "properties": {
        "wingman.baseUrl": {
          "type": "string",
          "default": "http://localhost:4242/v1",
          "description": "Base URL of the Wingman backend (OpenAI-compatible API).",
          "scope": "machine"
        },
        "wingman.apiKey": {
          "type": "string",
          "default": "-",
          "description": "API key for model discovery and chat requests to the Wingman backend. Run Wingman: Sync Models after changing it. Stored in plain settings, so keep the default for a local backend without authentication.",
          "scope": "machine"
        },
        "wingman.agentHost.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start Wingman's shared AHP host on port 9100 for the Wingman panel and register it in user settings for VS Code Chat and the Agents window. The first window runs the host and the others use it. Turning this off stops the host in every window. Requires wingman-agent and a VS Code window that supports AHP host settings.",
          "scope": "window"
        },
        "wingman.agentHost.executable": {
          "type": "string",
          "default": "wingman",
          "description": "Wingman executable path or launcher command, such as /bin/devtool wingman. When not explicitly set, reads path in WINGMAN_HOME (default ~/.wingman), then falls back to wingman on PATH. Quote paths or arguments containing spaces. Absolute Windows .exe paths can also be unquoted. Appends host --port 9100 automatically. Uses the agent's own provider configuration.",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "wingman",
          "title": "Wingman",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "wingman": [
        {
          "type": "webview",
          "id": "wingman.chat",
          "name": "Wingman",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "wingman.openChat",
        "title": "Open Chat",
        "category": "Wingman"
      },
      {
        "command": "wingman.newChat",
        "title": "New Chat",
        "category": "Wingman",
        "icon": "$(add)"
      },
      {
        "command": "wingman.chatHistory",
        "title": "Show Chat History",
        "category": "Wingman",
        "icon": "$(history)"
      },
      {
        "command": "wingman.renameSession",
        "title": "Rename Session",
        "category": "Wingman"
      },
      {
        "command": "wingman.syncModels",
        "title": "Sync Models",
        "category": "Wingman"
      },
      {
        "command": "wingman.startAgentHost",
        "title": "Start Agent Host",
        "category": "Wingman"
      },
      {
        "command": "wingman.stopAgentHost",
        "title": "Stop Agent Host",
        "category": "Wingman"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wingman.newChat",
          "when": "view == wingman.chat",
          "group": "navigation@1"
        },
        {
          "command": "wingman.chatHistory",
          "when": "view == wingman.chat",
          "group": "navigation@2"
        },
        {
          "command": "wingman.renameSession",
          "when": "view == wingman.chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit -p ./ && tsc -p src/webview",
    "pretest": "tsc -p ./ && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:custom-endpoints": "npm run build && node scripts/test-custom-endpoints.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@microsoft/agent-host-protocol": "^1.1.0",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/markdown": "^1.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.134.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3"
  }
}

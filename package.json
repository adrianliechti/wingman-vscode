{
  "name": "wingman-vscode",
  "publisher": "adrianliechti",
  "displayName": "Wingman AI",
  "description": "Wingman AI",
  "version": "0.3.13",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianliechti/wingman-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Wingman",
      "properties": {
        "wingman.baseUrl": {
          "type": "string",
          "default": "http://localhost:4242/v1",
          "description": "Base URL of the Wingman backend (OpenAI-compatible API).",
          "scope": "machine"
        },
        "wingman.apiKey": {
          "type": "string",
          "default": "-",
          "description": "API key sent to the Wingman backend. Stored in plain settings, so keep the default for a local backend without authentication.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "wingman.syncModels",
        "title": "Sync Models",
        "category": "Wingman"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit -p ./",
    "pretest": "tsc -p ./ && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.134.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  }
}
